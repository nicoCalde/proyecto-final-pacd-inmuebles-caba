# Datos crudos (shapefiles > 100 MB, se descargan de BA Data; ver README)
datasets/

# Material de la cátedra (de terceros, solo de consulta)
clases/

# Entorno virtual
.venv/

# Python
__pycache__/
*.py[cod]

# Caches de herramientas
.pytest_cache/

# Configuración local de Claude Code
.claude/settings.local.json
CLAUDE.local.md

# Modelos entrenados (un RandomForest puede superar el límite de 100 MB de GitHub)
models/

# Metadatos del paquete instalado en modo editable
*.egg-info/

# Logs de los scripts (se generan en cada ejecución)
logs/
